# ============ 阿里云百炼 API 配置 ============
DASHSCOPE_API_KEY=your-api-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============ 服务配置 ============
SERVER_PORT=3002
CORS_ORIGIN=*

# ============ 上传配置 ============
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp/image/bmp

# ============ Memgraph 图数据库 ============
# 设为 false 则知识图谱功能不可用，其他功能正常
MEMGRAPH_ENABLED=true
MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_USERNAME=
MEMGRAPH_PASSWORD=

# ============ LightRAG 知识图谱生成服务 ============
# 设为 false 则文档同步到图谱功能不可用，其他功能正常
LIGHTRAG_ENABLED=true
LIGHTRAG_BASE_URL=http://127.0.0.1:9621

# ============ 文件夹知识库 ============
KNOWLEDGE_BASE_DIR=知识库文件夹

# ============ 演示模式 ============
DEMO_MODE=true
GRAPH_DEMO_MAX_NODES=2000

#============= 知识管理假数据模式 ========
FAKE_MODE=false

SM4_KEY=f591d22985d179907d46f1cf6417e88a

# ---- MySQL 配置 ----
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=13306
DB_USER=SM4:pLVe8WoTzLi01PHPtaGMaJf6F4Y1T21Rw7YJlwx7prnfUruuK/tVwVoWkaf4qG69
DB_PASSWORD=SM4:SkgAyQh4COqiFx9XVmZlt4FPWQLOJPSA6nNsAseqnbl0f3yAZN8u0mIAlzDZGIqN
DB_NAME=sample_platform
SAMPLE_UPLOAD_DIR=D:\sample_platform_files


# ---- Oracle 配置 ----
# DB_TYPE=oracle
# DB_HOST=localhost
# DB_PORT=1521
# DB_USER=sys
# DB_PASSWORD=123456
# DB_NAME=ORCLPDB
# DB_SCHEMA=PDBADMIN
# DB_MODE=sysdba

# ---- Ceph 对象存储配置（图像采集使用） ----
CEPH_ENDPOINT=
CEPH_ACCESS_KEY=
CEPH_SECRET_KEY=
CEPH_SECURE=false

# 大版本变更阈值：样本总量每达到该阈值的下一个整数倍，大版本号 +1，小版本号归 0
SAMPLE_MAJOR_VERSION_THRESHOLD=1000
# 上传临时文件目录，用于批量导入大 ZIP 文件的临时存储；为空则使用系统临时目录（C:\Users\...\AppData\Local\Temp）
UPLOAD_TMP_DIR=D:\sample_platform_files\temp

# ---- 样本文件存储类型 ----
# 01-本地路径（沿用 SAMPLE_UPLOAD_DIR），02-minio 对象存储
STORAGE_TYPE=01
# MinIO 连接配置（STORAGE_TYPE=02 时生效）
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
# 桶名称：新建样本集时在该桶下以 setNo 作为前缀创建路径
MINIO_BUCKET=samples
