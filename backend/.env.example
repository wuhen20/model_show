# ============ 阿里云百炼 API 配置 ============
DASHSCOPE_API_KEY=your-api-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============ 服务配置 ============
SERVER_PORT=3002
CORS_ORIGIN=*

# ============ 上传配置 ============
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp,image/bmp