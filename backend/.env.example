# ============ 大模型 API 配置 ============
# 填入你自己的 API Key（请勿提交真实密钥）；兼容 OpenAI 协议的服务均可
DASHSCOPE_API_KEY=your-api-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============ 服务配置 ============
SERVER_PORT=3002
CORS_ORIGIN=*

# ============ 上传配置 ============
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp,image/bmp

# ============ 时序预测（Chronos-2）配置（可选）============
# 默认由 app/main.py 指向本地模型目录；如需自定义可取消注释并填写实际路径
# CHRONOS2_MODEL_PATH=E:/path/to/predict_api_chronos2/Model/chronos-2
# CHRONOS2_MODEL_ROOT=E:/path/to/predict_api_chronos2/Model
# 设为 1 可强制使用 CPU 推理（默认自动选择 GPU）
# CHRONOS2_FORCE_CPU=0
