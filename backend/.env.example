# ============ 阿里云百炼 API 配置 ============
DASHSCOPE_API_KEY=your-api-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============ 服务配置 ============
SERVER_PORT=3002
CORS_ORIGIN=*

# ============ 上传配置 ============
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp/image/bmp

# ============ Memgraph 图数据库 ============
# 设为 false 则知识图谱功能不可用，其他功能正常
MEMGRAPH_ENABLED=true
MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_USERNAME=
MEMGRAPH_PASSWORD=

# ============ LightRAG 知识图谱生成服务 ============
# 设为 false 则文档同步到图谱功能不可用，其他功能正常
LIGHTRAG_ENABLED=true
LIGHTRAG_BASE_URL=http://127.0.0.1:9621

# ============ 文件夹知识库 ============
KNOWLEDGE_BASE_DIR=知识库文件夹

# ============ 演示模式 ============
DEMO_MODE=true
GRAPH_DEMO_MAX_NODES=2000

#============= 知识管理假数据模式 ========
FAKE_MODE=false

DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=13306
DB_USER=root
DB_PASSWORD=Faker@T169
DB_NAME=sample_platform
SAMPLE_UPLOAD_DIR=E:\人工智能\现场作业专家系统
