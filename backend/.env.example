# ============ 阿里云百炼 API 配置 ============
DASHSCOPE_API_KEY=your-api-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============ 多模态目标检测配置 ============
# 留空时前端需手动填写，填写后作为默认值
DETECTION_ENDPOINT=
DETECTION_API_KEY=
DETECTION_MODEL_ID=
DETECTION_SYSTEM_PROMPT=
DETECTION_USER_PROMPT=
DETECTION_TEMPERATURE=
DETECTION_MAX_TOKENS=
DETECTION_ENABLE_THINKING=

# ============ 服务配置 ============
SERVER_PORT=3002
CORS_ORIGIN=*

# ============ 上传配置 ============
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp/image/bmp

# ============ Memgraph 图数据库 ============
# 设为 false 则知识图谱功能不可用，其他功能正常
MEMGRAPH_ENABLED=true
MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_USERNAME=
MEMGRAPH_PASSWORD=

# ============ LightRAG 知识图谱生成服务 ============
# 设为 false 则文档同步到图谱功能不可用，其他功能正常
LIGHTRAG_ENABLED=true
LIGHTRAG_BASE_URL=http://127.0.0.1:9621

# ============ 文件夹知识库 ============
KNOWLEDGE_BASE_DIR=知识库文件夹

# ============ 演示模式 ============
DEMO_MODE=true
GRAPH_DEMO_MAX_NODES=2000

#============= 知识管理假数据模式 ========
FAKE_MODE=false

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=sample_platform
